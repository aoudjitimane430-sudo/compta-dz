{
  "name": "compta-dz",
  "version": "1.0.0",
  "description": "Compta DZ - Logiciel comptable et fiscal SCF",
  "main": "main.js",
  "author": "Compta DZ",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dz.comptadz.app",
    "productName": "Compta DZ",
    "files": [
      "main.js",
      "ai_studio_code.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Compta-DZ-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Compta DZ",
      "artifactName": "Compta-DZ-Setup.exe"
    }
  }
}